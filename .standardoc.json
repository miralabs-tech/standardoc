{
  "version": 2,
  "docTag": "doc",
  "hideTag": "hide",
  "discovery": {
    "exclude": [],
    "exclude_files": ["docs-src/**", "**/*.generated.ts"],
    "virtual_annotations": "medium"
  },
  "tags": {
    "code": { "fields": ["value"], "cardinality": "single" },
    "severity": { "fields": ["value"], "cardinality": "single" },
    "category": { "fields": ["value"], "cardinality": "single" },
    "signature": { "fields": ["value"], "cardinality": "single" },
    "uri": { "fields": ["value"], "cardinality": "single" },
    "mime-type": { "fields": ["value"], "cardinality": "single" },
    "args-schema": { "fields": ["value"], "cardinality": "single" },
    "returns-schema": { "fields": ["value"], "cardinality": "single" },
    "exit-code": { "fields": ["code", "description"], "cardinality": "multi" },
    "flag": { "fields": ["name", "description"], "cardinality": "multi" },
    "method": { "fields": ["value"], "cardinality": "single" },
    "payload": { "fields": ["value"], "cardinality": "single" }
  },
  "watch": {
    "enabled": true,
    "debounceMs": 100
  }
}
