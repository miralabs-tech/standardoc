{
  "name": "standardoc",
  "displayName": "standardoc",
  "description": "AI-readable code documentation — Rust + TypeScript indexer surfaced over LSP and MCP.",
  "version": "1.0.0",
  "publisher": "miralabs-tech",
  "license": "LicenseRef-FSL-1.1-MIT",
  "homepage": "https://github.com/miralabs-tech/standardoc#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/miralabs-tech/standardoc.git",
    "directory": "ext/vscode"
  },
  "bugs": {
    "url": "https://github.com/miralabs-tech/standardoc/issues"
  },
  "icon": "media/icon.png",
  "qna": "marketplace",
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ai",
    "ai-readable",
    "documentation",
    "rust",
    "typescript",
    "lsp",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.105.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/.standardoc/",
    "workspaceContains:**/Cargo.toml",
    "workspaceContains:**/package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "Standardoc.daemon.restart",
        "title": "Daemon: Restart",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.findSymbol",
        "title": "Find symbol",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.getContext",
        "title": "Get context for symbol at cursor",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.initWorkspace",
        "title": "Initialize for this workspace",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.refreshMcpConfig",
        "title": "Refresh .mcp.json paths",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.resetGlobalInitPrompt",
        "title": "Reset global init prompt",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.regenerateSkill",
        "title": "Regenerate AI agent skill",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.daemon.stop",
        "title": "Daemon: Stop",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.daemon.start",
        "title": "Daemon: Start",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.purgeExcluded",
        "title": "Purge excluded paths",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.rag.toggle",
        "title": "Toggle RAG (prose retrieval)",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.rag.switchEmbedder",
        "title": "Switch RAG embedder…",
        "category": "Standardoc"
      },
      {
        "command": "Standardoc.rag.rebuild",
        "title": "Rebuild RAG index",
        "category": "Standardoc"
      }
    ],
    "configuration": {
      "title": "Standardoc",
      "properties": {
        "standardoc.binaryPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to a custom `standardoc` binary. When set, overrides the bundled binary in `dist/bin/`."
        },
        "standardoc.mcpHttpPort": {
          "type": "integer",
          "default": 7700,
          "minimum": 0,
          "maximum": 65535,
          "scope": "resource",
          "description": "TCP port on `127.0.0.1` where the Standardoc MCP daemon listens for streamable HTTP / SSE connections. Set to `0` to let the kernel pick a random ephemeral port (the resolved port is then written to `.standardoc/mcp.endpoint` for client discovery). When multiple Standardoc workspaces run in parallel, give each a distinct port here."
        },
        "standardoc.ragEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Enable the RAG (prose retrieval) layer. Adds `chunk_refs` to `get_context` responses and exposes the `fetch_chunks` MCP tool. The daemon restarts automatically when this changes."
        },
        "standardoc.ragEmbedder": {
          "type": "string",
          "enum": ["mock", "candle"],
          "default": "mock",
          "scope": "resource",
          "enumDescriptions": [
            "Deterministic zero-network BLAKE3-derived stub. Use for development and to exercise the tool surface without a model download.",
            "Local BGE-small-en-v1.5 (~130 MB). Downloaded on first use and cached at `~/.cache/standardoc/models/` (or platform equivalent). Override via STANDARDOC_MODELS_DIR."
          ],
          "description": "Embedder backend used when `standardoc.ragEnabled` is true. The daemon restarts automatically when this changes."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "standardoc.mcp",
        "label": "Standardoc"
      }
    ]
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --format=cjs --target=node --external=vscode --outdir=./dist --sourcemap=external",
    "build:prod": "bun build ./src/extension.ts --format=cjs --target=node --external=vscode --outdir=./dist --minify --sourcemap=external",
    "watch": "bun build ./src/extension.ts --format=cjs --target=node --external=vscode --outdir=./dist --watch --sourcemap=external",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "package": "bun run dev:bundle && bun run build:prod && vsce package",
    "vscode:prepublish": "bun run build:prod",
    "dev:daemon": "cargo build --manifest-path ../../Cargo.toml -p standardoc-cli",
    "dev:daemon:release": "cargo build --manifest-path ../../Cargo.toml -p standardoc-cli --release",
    "dev:bundle": "bun scripts/bundle-binary.ts",
    "dev:smoke": "bun run dev:daemon:release && bun run dev:bundle && bun run build:prod",
    "dev:install": "bun run package && bun scripts/install-vsix.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "matchigo": "^1.0.2",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.0.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
