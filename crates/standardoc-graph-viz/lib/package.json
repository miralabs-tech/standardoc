{
  "name": "@standarx/standardoc-viz",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable graph-viz UI components for the standardoc workspace index.",
  "type": "module",
  "sideEffects": [
    "./src/components/**/*.element.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/toolbar": "./src/components/toolbar/index.ts",
    "./components/hud": "./src/components/hud/index.ts",
