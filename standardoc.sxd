# Standardoc workspace config.
# Replaces the legacy .stdignore + drives explicit project discovery.
# When at least one `project` block is present, mechanical detection
# (cargo workspace + npm packages + lua rockspecs) is short-circuited
# and ONLY these projects are indexed.

version "0.1.0"

# Path patterns excluded from indexing (gitignore syntax).
ignore {
  patterns ```
.git/
node_modules/
target/
dist/
build/
.old/
*-old/
test-export/
```
}

project "standardoc" {
  label "Standardoc"
  paths ["crates" "ext/vscode"]
}

project "lur-workspace" {
  label "Lurlang"
  paths [".projects/lur-workspace" ".projects/lur-workspace/runtime"]
}

project "matchigo-lua" {
  label "Matchigo (Lua)"
  path ".projects/matchigo-lua"
}

project "standarx-dsl" {
  label "Standarx DSL"
  path ".projects/standarx-dsl"
}

# C.3 transport/runtime ports — declared explicitly so the schema
# hover surfaces the relevant doc and the values used here are visible
# at a glance. `proxy { ... }` is intentionally NOT declared: it's a
# per-machine singleton (default 7700) and `proxy.port` MUST differ
# from `mcp.port` (the proxy forwards INTO the mcp daemon).

mcp {
  port 7701
}

viz {
  port 3000
}
