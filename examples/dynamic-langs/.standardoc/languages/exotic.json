{
  "id": "exotic",
  "extensions": [".exo"],
  "commentStyles": {
    "single": ["#"],
    "docSingle": ["##"]
  },
  "backend": {
    "kind": "regex",
    "patterns": [
      {
        "kind": "function",
        "regex": "^\\s*fn\\s+(?P<name>[a-zA-Z_][a-zA-Z0-9_]*)\\s*\\((?P<params>[^)]*)\\)"
      },
      {
        "kind": "class",
        "regex": "^\\s*class\\s+(?P<name>[a-zA-Z_][a-zA-Z0-9_]*)"
      }
    ]
  }
}
